{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appfactory-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,
  "secrets": {
    "required": [
      "GITHUB_PRIVATE_KEY",
      "CLOUDFLARE_API_TOKEN"
    ]
  }
}
