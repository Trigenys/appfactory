{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__SERVICE_SLUG__",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__DATABASE_NAME__",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ]
}
