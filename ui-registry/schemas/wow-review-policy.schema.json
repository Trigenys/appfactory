{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trigenys/appfactory/blob/main/ui-registry/schemas/wow-review-policy.schema.json",
  "title": "WOW Frontend centrally reviewed source approvals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "defaultDisposition",
    "blocked",
    "approvals"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "defaultDisposition": {
      "const": "reference-only"
    },
    "blocked": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "repository",
          "commit",
          "spdx",
          "licenseEvidenceUrl",
          "reviewer",
          "reviewedOn",
          "allowedModes",
          "noticeFile"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "spdx": {
            "enum": [
              "MIT",
              "ISC",
              "Apache-2.0",
              "BSD-2-Clause",
              "BSD-3-Clause"
            ]
          },
          "licenseEvidenceUrl": {
            "type": "string",
            "minLength": 70
          },
          "reviewer": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,39}$"
          },
          "reviewedOn": {
            "type": "string",
            "format": "date"
          },
          "allowedModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "copy-adapt",
                "registry-install"
              ]
            }
          },
          "noticeFile": {
            "type": "string",
            "pattern": "^(THIRD_PARTY_NOTICES\\.md|licenses/[A-Za-z0-9_.@/-]+)$"
          }
        }
      }
    }
  }
}
