{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Trigenys/appfactory/blob/main/ui-registry/schemas/wow-adapters.schema.json",
  "title": "AppFactory WOW Frontend offline adapter hints v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "description",
    "adapters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "interfaceKind",
          "optionalService",
          "motionHints",
          "executable",
          "autoInstall",
          "notes"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "interfaceKind": {
            "enum": [
              "external-tool",
              "component-pattern",
              "registry-block",
              "guidance"
            ]
          },
          "optionalService": {
            "type": "boolean"
          },
          "motionHints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "motion",
                "gsap",
                "three"
              ]
            }
          },
          "executable": {
            "const": false
          },
          "autoInstall": {
            "const": false
          },
          "notes": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          }
        }
      }
    }
  }
}
